{
  "name": "opensheets",
  "version": "2.1.0",
  "description": "React spreadsheet component: virtualized grid, formulas, formatting, CSV/XLSX, and real-time collaboration",
  "keywords": [
    "spreadsheet",
    "excel",
    "google-sheets",
    "react",
    "typescript",
    "data-grid",
    "table",
    "virtual-scrolling",
    "formula",
    "csv",
    "xlsx",
    "collaborative-editing"
  ],
  "license": "MIT",
  "author": "OpenSheets Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w0h1v/OpenSheets.git"
  },
  "bugs": {
    "url": "https://github.com/w0h1v/OpenSheets/issues"
  },
  "homepage": "https://github.com/w0h1v/OpenSheets#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./excel": {
      "types": "./dist/types/excel.d.ts",
      "import": "./dist/excel.mjs",
      "require": "./dist/excel.cjs"
    },
    "./hyperformula": {
      "types": "./dist/types/hyperformula.d.ts",
      "import": "./dist/hyperformula.mjs",
      "require": "./dist/hyperformula.cjs"
    },
    "./server": {
      "types": "./server/relayCore.d.mts",
      "import": "./server/relayCore.mjs"
    },
    "./styles.css": "./dist/index.css",
    "./styles/tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "server/relayCore.mjs",
    "server/relayCore.d.mts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:relay": "node --test server/relayCore.test.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "lint": "eslint src examples server scripts deploy/worker.mjs --ext .ts,.tsx,.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "vite serve examples",
    "build:examples": "vite build examples",
    "preview": "vite preview examples",
    "serve": "node examples/server.mjs",
    "demo": "npm run build:examples && npm run serve",
    "release:check": "npm run typecheck && npm run typecheck:examples && npm run lint && npm test -- --ci && npm run test:relay && npm run build && npm run test:package",
    "prepublishOnly": "npm run release:check",
    "typecheck:examples": "tsc -p examples/tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "hyperformula": ">=2.7.1",
    "xlsx": ">=0.18.5",
    "ws": "^8.0.0",
    "redis": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "hyperformula": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.6.6",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "hyperformula": "2.7.1",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "redis": "6.2.1",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "ws": "8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "minimatch@9": "9.0.9"
  }
}
