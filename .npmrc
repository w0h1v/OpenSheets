# Supply-chain posture for everyone who installs this repo (see docs/SUPPLY-CHAIN.md).
# Never run install-time scripts from dependencies: the tree needs none
# (esbuild works from its optional platform package without its postinstall),
# and install scripts are the most common vehicle for a compromised package.
ignore-scripts=true
# New dependencies are recorded at the exact version that was reviewed.
save-exact=true
audit=true
fund=false
